            "srgb",
            "none"
          ],
          "title": "Color Profile",
          "type": "string"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "Canvas",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "duration_ms": {
          "default": 100,
