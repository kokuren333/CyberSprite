        "name": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "type": {
          "const": "group",
          "default": "group",
          "title": "Type",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "opacity": {
          "default": 255,
          "maximum": 255,
          "minimum": 0,
          "title": "Opacity",
          "type": "integer"
        },
        "blend_mode": {
          "default": "normal",
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color_dodge",
            "color_burn",
            "hard_light",
            "soft_light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity",
            "addition",
            "subtract",
            "divide"
          ],
          "title": "Blend Mode",
          "type": "string"
        },
        "collapsed": {
          "default": false,
          "title": "Collapsed",
          "type": "boolean"
        },
        "user_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/UserData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "discriminator": {
              "mapping": {
                "group": "#/$defs/GroupLayer",
                "image": "#/$defs/ImageLayer",
                "tilemap": "#/$defs/TilemapLayer"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ImageLayer"
              },
              {
                "$ref": "#/$defs/TilemapLayer"
              },
              {
                "$ref": "#/$defs/GroupLayer"
              }
            ]
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "GroupLayer",
      "type": "object"
    },
