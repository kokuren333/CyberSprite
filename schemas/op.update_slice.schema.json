{
  "$defs": {
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Rect",
      "type": "object"
    },
    "SliceKey": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        },
        "frame": {
          "title": "Frame",
          "type": "integer"
        },
        "center": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pivot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "frame"
      ],
      "title": "SliceKey",
      "type": "object"
    },
    "UserData": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "title": "UserData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "slice": {
      "description": "Slice ID or unique name.",
      "title": "Slice",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable resource name, at most 255 characters.",
      "title": "Name"
    },
    "color": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Raw display color as #rrggbb or #rrggbbaa; it need not belong to the palette.",
      "title": "Color"
    },
    "user_data": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserData"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Typed user metadata (text, display color, and properties)."
    },
    "keys": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SliceKey"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Ordered slice keys with zero-based frame and integer bounds.",
      "title": "Keys"
    },
    "set_key": {
      "anyOf": [
        {
          "$ref": "#/$defs/SliceKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Slice key to insert or replace at its frame."
    },
    "remove_key": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Zero-based frame of the slice key to remove.",
      "title": "Remove Key"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "slice",
    "project"
  ],
  "title": "update_sliceInput",
  "type": "object"
}
