{
  "$defs": {
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Rect",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "layer": {
      "description": "Target layer ID, unique name, or group path.",
      "title": "Layer",
      "type": "string"
    },
    "frame": {
      "description": "Zero-based frame index.",
      "title": "Frame",
      "type": "integer"
    },
    "rect": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rect"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Rectangle {x,y,w,h} in grid tile units; omission reads the whole cel."
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    }
  },
  "required": [
    "layer",
    "frame",
    "project"
  ],
  "title": "get_tilesInput",
  "type": "object"
}
