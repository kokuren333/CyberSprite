{
  "$defs": {
    "AllRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "AllRegion",
      "type": "object"
    },
    "Brush": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "shape": {
          "default": "square",
          "enum": [
            "square",
            "circle"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "title": "Brush",
      "type": "object"
    },
    "ColorRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "color",
          "title": "Type",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Color"
        }
      },
      "required": [
        "type",
        "color"
      ],
      "title": "ColorRegion",
      "type": "object"
    },
    "CombinedRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "and",
            "or",
            "not"
          ],
          "title": "Type",
          "type": "string"
        },
        "of": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/AllRegion",
                "and": "#/$defs/CombinedRegion",
                "color": "#/$defs/ColorRegion",
                "ellipse": "#/$defs/EllipseRegion",
                "mask": "#/$defs/MaskRegion",
                "not": "#/$defs/CombinedRegion",
                "or": "#/$defs/CombinedRegion",
                "polygon": "#/$defs/PolygonRegion",
                "rect": "#/$defs/RectRegion",
                "wand": "#/$defs/WandRegion"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AllRegion"
              },
              {
                "$ref": "#/$defs/RectRegion"
              },
              {
                "$ref": "#/$defs/EllipseRegion"
              },
              {
                "$ref": "#/$defs/PolygonRegion"
              },
              {
                "$ref": "#/$defs/MaskRegion"
              },
              {
                "$ref": "#/$defs/ColorRegion"
              },
              {
                "$ref": "#/$defs/WandRegion"
              },
              {
                "$ref": "#/$defs/CombinedRegion"
              }
            ]
          },
          "title": "Of",
          "type": "array"
        }
      },
      "required": [
        "type",
        "of"
      ],
      "title": "CombinedRegion",
      "type": "object"
    },
    "DrawingMask": {
      "additionalProperties": false,
      "properties": {
        "only_on": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Only On"
        },
        "not_on": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not On"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllRegion",
              "and": "#/$defs/CombinedRegion",
              "color": "#/$defs/ColorRegion",
              "ellipse": "#/$defs/EllipseRegion",
              "mask": "#/$defs/MaskRegion",
              "not": "#/$defs/CombinedRegion",
              "or": "#/$defs/CombinedRegion",
              "polygon": "#/$defs/PolygonRegion",
              "rect": "#/$defs/RectRegion",
              "wand": "#/$defs/WandRegion"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllRegion"
            },
            {
              "$ref": "#/$defs/RectRegion"
            },
            {
              "$ref": "#/$defs/EllipseRegion"
            },
            {
              "$ref": "#/$defs/PolygonRegion"
            },
            {
              "$ref": "#/$defs/MaskRegion"
            },
            {
              "$ref": "#/$defs/ColorRegion"
            },
            {
              "$ref": "#/$defs/WandRegion"
            },
            {
              "$ref": "#/$defs/CombinedRegion"
            }
          ],
          "title": "Region"
        }
      },
      "title": "DrawingMask",
      "type": "object"
    },
    "EllipseRegion": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        },
        "type": {
          "const": "ellipse",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "type"
      ],
      "title": "EllipseRegion",
      "type": "object"
    },
    "MaskRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mask",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "rows"
      ],
      "title": "MaskRegion",
      "type": "object"
    },
    "PolygonRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "polygon",
          "title": "Type",
          "type": "string"
        },
        "points": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "type",
        "points"
      ],
      "title": "PolygonRegion",
      "type": "object"
    },
    "RectRegion": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        },
        "type": {
          "const": "rect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "type"
      ],
      "title": "RectRegion",
      "type": "object"
    },
    "WandRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "wand",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "connectivity": {
          "default": 4,
          "enum": [
            4,
            8
          ],
          "title": "Connectivity",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "x",
        "y"
      ],
      "title": "WandRegion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "layer": {
      "description": "Target layer ID, unique name, or group path.",
      "title": "Layer",
      "type": "string"
    },
    "frame": {
      "description": "Zero-based frame index.",
      "title": "Frame",
      "type": "integer"
    },
    "points": {
      "description": "Ordered integer [x, y] coordinates.",
      "items": {
        "items": {
          "type": "integer"
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array"
      },
      "title": "Points",
      "type": "array"
    },
    "color": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Palette index, @name, or an exact palette color; editing never approximates colors.",
      "title": "Color"
    },
    "filled": {
      "default": false,
      "description": "Fill the shape interior instead of drawing only its boundary.",
      "title": "Filled",
      "type": "boolean"
    },
    "closed": {
      "default": true,
      "description": "Join the final polygon point back to the first.",
      "title": "Closed",
      "type": "boolean"
    },
    "brush": {
      "$ref": "#/$defs/Brush",
      "description": "Integer brush size (1-64) and square or circle footprint."
    },
    "mask": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrawingMask"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional protection: only_on/not_on colors and region, tested once before drawing.",
      "x-cybersprite-region-mask": true
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "layer",
    "frame",
    "points",
    "color",
    "project"
  ],
  "title": "polygonInput",
  "type": "object"
}
