{
  "additionalProperties": false,
  "properties": {
    "width": {
      "description": "Width in integer pixels.",
      "minimum": 1,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "description": "Height in integer pixels.",
      "minimum": 1,
      "title": "Height",
      "type": "integer"
    },
    "anchor": {
      "default": "nw",
      "description": "Canvas resize anchor using compass directions; c means center.",
      "enum": [
        "nw",
        "n",
        "ne",
        "w",
        "c",
        "e",
        "sw",
        "s",
        "se"
      ],
      "title": "Anchor",
      "type": "string"
    },
    "discard_outside": {
      "default": false,
      "description": "Discard cel pixels outside the new canvas bounds.",
      "title": "Discard Outside",
      "type": "boolean"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "width",
    "height",
    "project"
  ],
  "title": "resize_canvasInput",
  "type": "object"
}
