{
  "$defs": {
    "Above": {
      "additionalProperties": false,
      "properties": {
        "above": {
          "title": "Above",
          "type": "string"
        }
      },
      "required": [
        "above"
      ],
      "title": "Above",
      "type": "object"
    },
    "Below": {
      "additionalProperties": false,
      "properties": {
        "below": {
          "title": "Below",
          "type": "string"
        }
      },
      "required": [
        "below"
      ],
      "title": "Below",
      "type": "object"
    },
    "UserData": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "title": "UserData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "layer": {
      "description": "Target layer ID, unique name, or group path.",
      "title": "Layer",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable resource name, at most 255 characters.",
      "title": "Name"
    },
    "visible": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Include this layer in normal rendering.",
      "title": "Visible"
    },
    "locked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Prevent edits to this layer and its descendants.",
      "title": "Locked"
    },
    "continuous": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Use linked cels when automatically extending the layer timeline.",
      "title": "Continuous"
    },
    "collapsed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Store the group collapsed state for clients.",
      "title": "Collapsed"
    },
    "background": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Make this image layer an opaque canvas-sized bottom background when true.",
      "title": "Background"
    },
    "opacity": {
      "anyOf": [
        {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Opacity from 0 (transparent) to 255 (opaque).",
      "title": "Opacity"
    },
    "blend_mode": {
      "anyOf": [
        {
          "enum": [
            "normal",
            "multiply",
            "screen",
            "overlay",
            "darken",
            "lighten",
            "color_dodge",
            "color_burn",
            "hard_light",
            "soft_light",
            "difference",
            "exclusion",
            "hue",
            "saturation",
            "color",
            "luminosity",
            "addition",
            "subtract",
            "divide"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Layer blend mode; non-normal modes use the v1 fallback renderer.",
      "title": "Blend Mode"
    },
    "user_data": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserData"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Typed user metadata (text, display color, and properties)."
    },
    "parent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Parent group reference; omit for a top-level layer.",
      "title": "Parent"
    },
    "position": {
      "anyOf": [
        {
          "enum": [
            "top",
            "bottom"
          ],
          "type": "string"
        },
        {
          "$ref": "#/$defs/Above"
        },
        {
          "$ref": "#/$defs/Below"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stack position: top, bottom, or an above/below layer reference.",
      "title": "Position"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "layer",
    "project"
  ],
  "title": "update_layerInput",
  "type": "object"
}
