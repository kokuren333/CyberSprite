{
  "$defs": {
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "default": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "default": 16,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "default": 16,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        }
      },
      "title": "Grid",
      "type": "object"
    },
    "Size": {
      "additionalProperties": false,
      "properties": {
        "w": {
          "default": 1,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "default": 1,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        }
      },
      "title": "Size",
      "type": "object"
    },
    "UserData": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{8}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "title": "Properties"
        }
      },
      "title": "UserData",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "name": {
      "anyOf": [
        {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Human-readable resource name, at most 255 characters.",
      "title": "Name"
    },
    "grid": {
      "anyOf": [
        {
          "$ref": "#/$defs/Grid"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Stored integer document grid settings."
    },
    "pixel_ratio": {
      "anyOf": [
        {
          "$ref": "#/$defs/Size"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Integer display pixel ratio {w,h}."
    },
    "user_data": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserData"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Typed user metadata (text, display color, and properties)."
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "project"
  ],
  "title": "set_project_metaInput",
  "type": "object"
}
