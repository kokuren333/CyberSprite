{
  "$defs": {
    "Guide": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Registered source image path; workspace-relative in MCP.",
          "title": "File",
          "x-cybersprite-path": "input"
        },
        "x": {
          "default": 0,
          "minimum": 0,
          "title": "X",
          "type": "integer"
        },
        "y": {
          "default": 0,
          "minimum": 0,
          "title": "Y",
          "type": "integer"
        },
        "scale": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "mode": {
          "const": "side",
          "default": "side",
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "Guide",
      "type": "object"
    },
    "Onion": {
      "additionalProperties": false,
      "properties": {
        "prev": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Prev",
          "type": "integer"
        },
        "next": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Next",
          "type": "integer"
        },
        "loop_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tag ID or unique name to wrap onion frames within.",
          "title": "Loop Tag"
        }
      },
      "title": "Onion",
      "type": "object"
    },
    "Rect": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Rect",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "frames": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "string"
        }
      ],
      "description": "Frame selection: zero-based index, index list, all, range 0-3, or tag:name.",
      "title": "Frames"
    },
    "tileset": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tileset ID or unique name; render its labeled tile grid.",
      "title": "Tileset"
    },
    "layout": {
      "default": "frames",
      "description": "Separate images (at most 8), strip, grid, or review sheet.",
      "enum": [
        "frames",
        "strip",
        "grid",
        "review"
      ],
      "title": "Layout",
      "type": "string"
    },
    "layers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Layer references to include; omission uses the operation default selection.",
      "title": "Layers"
    },
    "scale": {
      "anyOf": [
        {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        {
          "const": "auto",
          "type": "string"
        }
      ],
      "default": "auto",
      "description": "Integer nearest-neighbor scale; auto fits previews within their size limit.",
      "title": "Scale"
    },
    "grid": {
      "default": false,
      "description": "Overlay the stored integer document grid.",
      "title": "Grid",
      "type": "boolean"
    },
    "rulers": {
      "default": false,
      "description": "Add integer coordinate rulers to the diagnostic preview.",
      "title": "Rulers",
      "type": "boolean"
    },
    "onion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Onion"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Number of previous and next frames to include as onion skins (0-8 each)."
    },
    "rect": {
      "anyOf": [
        {
          "$ref": "#/$defs/Rect"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Integer rectangle {x,y,w,h}; content requests the opaque content bounds when supported."
    },
    "guide": {
      "anyOf": [
        {
          "$ref": "#/$defs/Guide"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Design source beside the preview: source, file, x/y crop origin, integer scale, mode=side."
    },
    "background": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "default": "checker",
      "description": "Checker, palette index/exact color, or raw #rrggbb decoration.",
      "title": "Background"
    },
    "inline": {
      "default": true,
      "description": "Include base64 PNG data for clients that display inline images.",
      "title": "Inline",
      "type": "boolean"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    }
  },
  "required": [
    "project"
  ],
  "title": "render_previewInput",
  "type": "object"
}
