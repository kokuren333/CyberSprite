{
  "$defs": {
    "Brush": {
      "additionalProperties": false,
      "properties": {
        "size": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        },
        "shape": {
          "default": "square",
          "enum": [
            "square",
            "circle"
          ],
          "title": "Shape",
          "type": "string"
        }
      },
      "title": "Brush",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "layer": {
      "description": "Target layer ID, unique name, or group path.",
      "title": "Layer",
      "type": "string"
    },
    "frame": {
      "description": "Zero-based frame index.",
      "title": "Frame",
      "type": "integer"
    },
    "x": {
      "description": "Horizontal pixel coordinate from the canvas left edge.",
      "title": "X",
      "type": "integer"
    },
    "y": {
      "description": "Vertical pixel coordinate from the canvas top edge.",
      "title": "Y",
      "type": "integer"
    },
    "w": {
      "description": "Width in integer pixels.",
      "minimum": 1,
      "title": "W",
      "type": "integer"
    },
    "h": {
      "description": "Height in integer pixels.",
      "minimum": 1,
      "title": "H",
      "type": "integer"
    },
    "color": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Palette index or an exact palette color; editing never approximates colors.",
      "title": "Color"
    },
    "filled": {
      "default": false,
      "description": "Fill the shape interior instead of drawing only its boundary.",
      "title": "Filled",
      "type": "boolean"
    },
    "brush": {
      "$ref": "#/$defs/Brush",
      "description": "Integer brush size (1-64) and square or circle footprint."
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "layer",
    "frame",
    "x",
    "y",
    "w",
    "h",
    "color",
    "project"
  ],
  "title": "rectInput",
  "type": "object"
}
