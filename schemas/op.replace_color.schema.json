{
  "$defs": {
    "AllRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "all",
          "default": "all",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "AllRegion",
      "type": "object"
    },
    "ColorRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "color",
          "title": "Type",
          "type": "string"
        },
        "color": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Color"
        }
      },
      "required": [
        "type",
        "color"
      ],
      "title": "ColorRegion",
      "type": "object"
    },
    "CombinedRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "and",
            "or",
            "not"
          ],
          "title": "Type",
          "type": "string"
        },
        "of": {
          "items": {
            "discriminator": {
              "mapping": {
                "all": "#/$defs/AllRegion",
                "and": "#/$defs/CombinedRegion",
                "color": "#/$defs/ColorRegion",
                "ellipse": "#/$defs/EllipseRegion",
                "mask": "#/$defs/MaskRegion",
                "not": "#/$defs/CombinedRegion",
                "or": "#/$defs/CombinedRegion",
                "polygon": "#/$defs/PolygonRegion",
                "rect": "#/$defs/RectRegion",
                "wand": "#/$defs/WandRegion"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AllRegion"
              },
              {
                "$ref": "#/$defs/RectRegion"
              },
              {
                "$ref": "#/$defs/EllipseRegion"
              },
              {
                "$ref": "#/$defs/PolygonRegion"
              },
              {
                "$ref": "#/$defs/MaskRegion"
              },
              {
                "$ref": "#/$defs/ColorRegion"
              },
              {
                "$ref": "#/$defs/WandRegion"
              },
              {
                "$ref": "#/$defs/CombinedRegion"
              }
            ]
          },
          "title": "Of",
          "type": "array"
        }
      },
      "required": [
        "type",
        "of"
      ],
      "title": "CombinedRegion",
      "type": "object"
    },
    "DrawingMask": {
      "additionalProperties": false,
      "properties": {
        "only_on": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Only On"
        },
        "not_on": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not On"
        },
        "region": {
          "discriminator": {
            "mapping": {
              "all": "#/$defs/AllRegion",
              "and": "#/$defs/CombinedRegion",
              "color": "#/$defs/ColorRegion",
              "ellipse": "#/$defs/EllipseRegion",
              "mask": "#/$defs/MaskRegion",
              "not": "#/$defs/CombinedRegion",
              "or": "#/$defs/CombinedRegion",
              "polygon": "#/$defs/PolygonRegion",
              "rect": "#/$defs/RectRegion",
              "wand": "#/$defs/WandRegion"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/AllRegion"
            },
            {
              "$ref": "#/$defs/RectRegion"
            },
            {
              "$ref": "#/$defs/EllipseRegion"
            },
            {
              "$ref": "#/$defs/PolygonRegion"
            },
            {
              "$ref": "#/$defs/MaskRegion"
            },
            {
              "$ref": "#/$defs/ColorRegion"
            },
            {
              "$ref": "#/$defs/WandRegion"
            },
            {
              "$ref": "#/$defs/CombinedRegion"
            }
          ],
          "title": "Region"
        }
      },
      "title": "DrawingMask",
      "type": "object"
    },
    "EllipseRegion": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        },
        "type": {
          "const": "ellipse",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "type"
      ],
      "title": "EllipseRegion",
      "type": "object"
    },
    "MaskRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "mask",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "rows": {
          "items": {
            "type": "string"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "type",
        "x",
        "y",
        "rows"
      ],
      "title": "MaskRegion",
      "type": "object"
    },
    "PolygonRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "polygon",
          "title": "Type",
          "type": "string"
        },
        "points": {
          "items": {
            "items": {
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "type",
        "points"
      ],
      "title": "PolygonRegion",
      "type": "object"
    },
    "RectRegion": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "w": {
          "minimum": 0,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "minimum": 0,
          "title": "H",
          "type": "integer"
        },
        "type": {
          "const": "rect",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h",
        "type"
      ],
      "title": "RectRegion",
      "type": "object"
    },
    "WandRegion": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "wand",
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        },
        "connectivity": {
          "default": 4,
          "enum": [
            4,
            8
          ],
          "title": "Connectivity",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "x",
        "y"
      ],
      "title": "WandRegion",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "from": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Palette index or exact palette color to replace.",
      "title": "From"
    },
    "to": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "description": "Replacement palette index or exact palette color.",
      "title": "To"
    },
    "layers": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Layer references to include; omission uses the operation default selection.",
      "title": "Layers"
    },
    "frames": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        {
          "type": "string"
        }
      ],
      "default": "all",
      "description": "Frame selection: zero-based index, index list, all, range 0-3, or tag:name.",
      "title": "Frames"
    },
    "region": {
      "description": "Canvas selection: all, rect, ellipse, polygon, mask, color, wand, bounded and/or/not tree.",
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllRegion",
          "and": "#/$defs/CombinedRegion",
          "color": "#/$defs/ColorRegion",
          "ellipse": "#/$defs/EllipseRegion",
          "mask": "#/$defs/MaskRegion",
          "not": "#/$defs/CombinedRegion",
          "or": "#/$defs/CombinedRegion",
          "polygon": "#/$defs/PolygonRegion",
          "rect": "#/$defs/RectRegion",
          "wand": "#/$defs/WandRegion"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AllRegion"
        },
        {
          "$ref": "#/$defs/RectRegion"
        },
        {
          "$ref": "#/$defs/EllipseRegion"
        },
        {
          "$ref": "#/$defs/PolygonRegion"
        },
        {
          "$ref": "#/$defs/MaskRegion"
        },
        {
          "$ref": "#/$defs/ColorRegion"
        },
        {
          "$ref": "#/$defs/WandRegion"
        },
        {
          "$ref": "#/$defs/CombinedRegion"
        }
      ],
      "title": "Region"
    },
    "tilesets": {
      "default": false,
      "description": "Also process tileset pixels when supported.",
      "title": "Tilesets",
      "type": "boolean"
    },
    "mask": {
      "anyOf": [
        {
          "$ref": "#/$defs/DrawingMask"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional protection: only_on/not_on colors and region, tested once before drawing.",
      "x-cybersprite-region-mask": true
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "from",
    "to",
    "project"
  ],
  "title": "replace_colorInput",
  "type": "object"
}
