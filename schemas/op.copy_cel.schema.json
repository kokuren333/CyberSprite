{
  "additionalProperties": false,
  "properties": {
    "layer": {
      "description": "Target layer ID, unique name, or group path.",
      "title": "Layer",
      "type": "string"
    },
    "frame": {
      "description": "Zero-based frame index.",
      "title": "Frame",
      "type": "integer"
    },
    "to_layer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Destination layer reference; omit to use the source layer.",
      "title": "To Layer"
    },
    "to_frame": {
      "description": "Zero-based destination frame index.",
      "title": "To Frame",
      "type": "integer"
    },
    "mode": {
      "default": "copy",
      "description": "Copy or move the source cel.",
      "enum": [
        "copy",
        "move"
      ],
      "title": "Mode",
      "type": "string"
    },
    "on_conflict": {
      "default": "replace",
      "description": "How to handle an occupied destination: replace, error, or skip.",
      "enum": [
        "replace",
        "error",
        "skip"
      ],
      "title": "On Conflict",
      "type": "string"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "layer",
    "frame",
    "to_frame",
    "project"
  ],
  "title": "copy_celInput",
  "type": "object"
}
