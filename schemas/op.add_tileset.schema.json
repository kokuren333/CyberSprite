{
  "additionalProperties": false,
  "properties": {
    "name": {
      "description": "Human-readable resource name, at most 255 characters.",
      "maxLength": 255,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "tile_w": {
      "description": "Tile width in pixels (1-256).",
      "maximum": 256,
      "minimum": 1,
      "title": "Tile W",
      "type": "integer"
    },
    "tile_h": {
      "description": "Tile height in pixels (1-256).",
      "maximum": 256,
      "minimum": 1,
      "title": "Tile H",
      "type": "integer"
    },
    "base_index": {
      "default": 1,
      "description": "Display-only starting tile number; stored indices always start at zero.",
      "title": "Base Index",
      "type": "integer"
    },
    "if_exists": {
      "default": "error",
      "description": "Policy when a matching resource already exists; see the allowed enum values.",
      "enum": [
        "error",
        "reuse",
        "allow"
      ],
      "title": "If Exists",
      "type": "string"
    },
    "project": {
      "description": "Project directory or project.json path.",
      "title": "Project",
      "type": "string"
    },
    "expect_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reject if the current revision differs.",
      "title": "Expect Revision"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Replay a prior result for this transaction key.",
      "title": "Idempotency Key"
    },
    "dry_run": {
      "default": false,
      "description": "Validate without committing project changes.",
      "title": "Dry Run",
      "type": "boolean"
    },
    "preview": {
      "default": "path",
      "description": "Return no preview, PNG paths, or inline PNG images.",
      "enum": [
        "none",
        "path",
        "inline"
      ],
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "name",
    "tile_w",
    "tile_h",
    "project"
  ],
  "title": "add_tilesetInput",
  "type": "object"
}
