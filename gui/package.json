{
  "name": "cybersprite-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run icons && vite --host 127.0.0.1",
    "icons": "node scripts/build-icons.mjs",
    "build": "npm run icons && tsc --noEmit && vite build",
    "test": "vitest run && npm run check:contrast",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "licenses": "node ../tools/check_js_licenses.mjs --check"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "5.1.0"
  }
}
